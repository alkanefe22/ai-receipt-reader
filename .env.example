# ─────────────────────────────────────────────────────────────
# AI Receipt & Invoice Reader — environment configuration
# Copy to .env.local and fill in. Without API keys the app runs in DEMO mode.
# ─────────────────────────────────────────────────────────────

# Force demo mode even if keys are present (true/false).
DEMO_MODE=false

# ── Provider API keys ────────────────────────────────────────
# Only the providers referenced by the three roles below need a key.
# Gemini-only setup: set all three *_PROVIDER to google and leave ANTHROPIC_API_KEY empty.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Models ───────────────────────────────────────────────────
# Provider is one of: anthropic | google | ollama
# Model IDs are NOT hard-coded anywhere in the code; set them here.
# Check each provider's docs for the current model IDs.
EXTRACTOR_A_PROVIDER=anthropic
EXTRACTOR_A_MODEL=claude-sonnet-5

EXTRACTOR_B_PROVIDER=google
EXTRACTOR_B_MODEL=gemini-3.8-flash

# The arbiter reads disputed fields blind (it never sees A/B values).
# Default is Claude; see README "Design notes" for the correlation trade-off.
ARBITER_PROVIDER=anthropic
ARBITER_MODEL=claude-opus-5-5

# ── Local models via Ollama (no API key) ─────────────────────
# Use provider "ollama" for any role and a *vision* model you have pulled
# (`ollama list`). Ollama cannot read PDFs: with an Ollama role, PDF uploads
# are rejected; upload JPG/PNG instead. Local models are slower, so consider
# raising MODEL_TIMEOUT_SECONDS.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# ── Limits ───────────────────────────────────────────────────
# Per-IP requests allowed per window in live mode.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600
# Max upload size per file, in megabytes.
MAX_FILE_MB=10
# Per model-call timeout, in seconds.
MODEL_TIMEOUT_SECONDS=60
# Total attempts per model call, including the first (1 = no retry).
# Keep 1 on free-tier keys: every retry re-sends the image and spends quota.
MODEL_MAX_ATTEMPTS=1

# Optional: shared rate-limit store across serverless instances (Upstash Redis REST).
# If unset, an in-memory limiter is used (per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
